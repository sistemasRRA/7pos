@page "/"
@layout PosLayout
@inject PriceListService PriceListService
@inject PosSession Session

<PageTitle>Catálogo · 7Pos</PageTitle>

<h1>Catálogo</h1>
<p class="hint">Precios de esta sucursal (IVA incluido). Elige una prenda y responde sus preguntas para ver el desglose.</p>

@if (_catalog is null)
{
    <p>Cargando…</p>
}
else if (_catalog.Count == 0)
{
    <p class="notice">Esta sucursal no tiene precios asignados. Avísale a Mercadotecnia.</p>
}
else if (_selected is null)
{
    <ProductPicker Catalog="_catalog" OnSelected="entry => _selected = entry" />
}
else
{
    <div class="preview">
        <GarmentCapture Entry="_selected" OnCancel="() => _selected = null" />
    </div>
}

@code {
    private List<CatalogEntry>? _catalog;
    private CatalogEntry? _selected;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser is { } user)
            _catalog = await PriceListService.GetBranchCatalogAsync(user.BranchId);
    }
}
