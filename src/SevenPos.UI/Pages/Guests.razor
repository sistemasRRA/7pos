@page "/guests"
@layout PosLayout

<PageTitle>Clientes · 7Pos</PageTitle>

<h1>Clientes</h1>

@if (_selected is not null)
{
    @if (_justRegistered) { <p class="notice" role="status">Cliente registrado.</p> }
    <GuestCard Guest="_selected" />
    <p><button type="button" class="secondary" @onclick="NewSearch">Buscar otro cliente</button></p>
}
else
{
    <GuestPicker OnSelected="guest => Select(guest, isNew: false)"
                 OnRegistered="guest => Select(guest, isNew: true)" />
}

@code {
    private Guest? _selected;
    private bool _justRegistered;

    private void Select(Guest guest, bool isNew)
    {
        _selected = guest;
        _justRegistered = isNew;
    }

    private void NewSearch() => _selected = null;
}
