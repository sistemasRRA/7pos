@page "/prices"
@layout PosLayout
@inject PriceListService PriceListService
@inject PosSession Session
@inject TimeProvider Clock

<PageTitle>Precios · 7Pos</PageTitle>

<h1>Listas de precios</h1>

@if (Session.CurrentUser?.Role != UserRole.Marketing)
{
    <p class="notice">Solo Mercadotecnia puede administrar precios.</p>
}
else if (_lists is null)
{
    <p>Cargando…</p>
}
else if (_lists.Count == 0)
{
    <p class="notice">No hay listas de precios.</p>
}
else
{
    <label class="list-picker">
        Lista
        <select value="@_listId" @onchange="OnListChangedAsync">
            @foreach (var list in _lists)
            {
                <option value="@list.Id">@list.Name</option>
            }
        </select>
    </label>
    <p class="hint">Precios con IVA incluido. Un cambio nunca borra el precio anterior: queda en el historial.</p>

    <div class="layout">
        <table>
            <thead>
                <tr><th>Prenda</th><th>Categoría</th><th class="num">Precio actual</th><th>Próximo cambio</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var row in _rows ?? [])
                {
                    <tr class="@(row.Product.Id == _editing?.Product.Id ? "editing" : "")">
                        <td>@row.Product.Name</td>
                        <td>@row.Product.Category?.Name</td>
                        <td class="num">@(row.CurrentPrice is { } price ? Display.Money(price) : "Sin precio")</td>
                        <td>@(row.NextPrice is { } next ? $"{Display.Money(next)} desde {Display.DateTime(row.NextEffectiveFromUtc!.Value)}" : "—")</td>
                        <td><button type="button" class="secondary" @onclick="() => EditAsync(row)">Cambiar</button></td>
                    </tr>
                }
            </tbody>
        </table>

        @if (_editing is not null)
        {
            <aside class="editor">
                <h2>@_editing.Product.Name</h2>
                <form @onsubmit="SaveAsync">
                    <label>
                        Nuevo precio
                        <input type="number" step="0.01" min="0.01" @bind="_newPrice" />
                    </label>
                    <label>
                        A partir del <span class="optional">(vacío = ahora)</span>
                        <input type="date" @bind="_effectiveDay" min="@Display.LocalToday(Clock).ToString("yyyy-MM-dd")" />
                    </label>
                    @if (_error is not null) { <p class="error" role="alert">@_error</p> }
                    @if (_saved) { <p class="ok" role="status">Precio guardado.</p> }
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="() => _editing = null">Cerrar</button>
                        <button type="submit" class="primary" disabled="@_busy">Guardar</button>
                    </div>
                </form>

                <h3>Historial</h3>
                @if (_history is { Count: > 0 })
                {
                    <ul class="history">
                        @foreach (var h in _history)
                        {
                            <li><strong>@Display.Money(h.Price)</strong> desde @Display.DateTime(h.EffectiveFromUtc) · @h.SetBy</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="hint">Esta prenda aún no tiene precio en esta lista.</p>
                }
            </aside>
        }
    </div>
}

@code {
    private List<PriceList>? _lists;
    private Guid _listId;
    private List<ListPrice>? _rows;
    private ListPrice? _editing;
    private List<PriceHistoryEntry>? _history;
    private decimal? _newPrice;
    private DateOnly? _effectiveDay;
    private string? _error;
    private bool _busy, _saved;

    protected override async Task OnInitializedAsync()
    {
        if (Session.CurrentUser?.Role != UserRole.Marketing) return;
        _lists = await PriceListService.GetPriceListsAsync();
        if (_lists.Count > 0)
        {
            _listId = _lists[0].Id;
            await LoadRowsAsync();
        }
    }

    private async Task OnListChangedAsync(ChangeEventArgs e)
    {
        _listId = Guid.Parse((string)e.Value!);
        _editing = null;
        await LoadRowsAsync();
    }

    private async Task LoadRowsAsync() => _rows = await PriceListService.GetListPricesAsync(_listId);

    private async Task EditAsync(ListPrice row)
    {
        _editing = row;
        _newPrice = row.CurrentPrice;
        _effectiveDay = null;
        _error = null;
        _saved = false;
        _history = await PriceListService.GetHistoryAsync(_listId, row.Product.Id);
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;
        if (_newPrice is null)
        {
            _error = "Escribe el nuevo precio.";
            return;
        }

        // Empty or today means "now"; a later day starts at local midnight.
        DateTime? effectiveFromUtc = _effectiveDay is { } day && day > Display.LocalToday(Clock)
            ? Display.StartOfLocalDayUtc(day)
            : null;

        _busy = true;
        var result = await PriceListService.SetPriceAsync(Session.CurrentUser!.Id, _listId, _editing!.Product.Id, _newPrice.Value, effectiveFromUtc);
        _busy = false;

        if (!result.Succeeded)
        {
            _error = result.Error switch
            {
                PriceChangeError.InvalidPrice => "El precio debe ser mayor a cero y con centavos exactos.",
                PriceChangeError.EffectiveDateInPast => "La fecha no puede ser en el pasado.",
                PriceChangeError.NotAllowed => "Solo Mercadotecnia puede cambiar precios.",
                _ => "No se pudo guardar el precio.",
            };
            return;
        }

        _saved = true;
        await LoadRowsAsync();
        _editing = _rows!.First(r => r.Product.Id == _editing.Product.Id);
        _history = await PriceListService.GetHistoryAsync(_listId, _editing.Product.Id);
    }
}
