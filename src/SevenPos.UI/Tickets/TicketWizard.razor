@page "/tickets/new"
@layout PosLayout
@inject PriceListService PriceListService
@inject TicketService TicketService
@inject PosSession Session

@* Ticket capture wizard: Cliente → Prendas → Confirmar. Rules: docs/features/ticket-wizard.md.
   Prices shown here are a preview; TicketService prices the ticket again from the branch list. *@

<PageTitle>Nuevo ticket · 7Pos</PageTitle>

<h1>Nuevo ticket</h1>

@if (Session.CurrentUser?.Role == UserRole.Marketing)
{
    <p class="notice">Mercadotecnia no captura tickets. Entra con un usuario de sucursal.</p>
}
else if (_created is not null)
{
    <p class="success" role="status">Ticket creado.</p>
    <div class="created">
        <dl class="facts">
            <dt>Folio</dt><dd>@_created.Folio.ToString("D6")</dd>
            <dt>Número de orden</dt><dd class="order-id">@_created.PublicOrderId</dd>
            <dt>Cliente</dt><dd>@_created.Guest!.FullName · @PhoneNumber.Format(_created.Guest.Phone)</dd>
            <dt>Fecha</dt><dd>@Display.DateTime(_created.CreatedAtUtc)</dd>
        </dl>
        <p class="hint">Dale al cliente el número de orden. Cada prenda lleva su etiqueta.</p>

        <table class="labels">
            <thead><tr><th>Etiqueta</th><th>Prenda</th><th>Servicios</th><th class="money">Precio</th></tr></thead>
            <tbody>
                @foreach (var garment in _created.Garments)
                {
                    <tr>
                        <td class="code">@garment.Code</td>
                        <td>@garment.Product!.Name</td>
                        <td>@(garment.Modifiers.Count == 0 ? "—" : string.Join(" · ", garment.Modifiers.Select(m => Display.Option(m.Modifier!))))</td>
                        <td class="money">@Display.Money(garment.PriceCharged)</td>
                    </tr>
                }
            </tbody>
        </table>

        <Totals Total="_created.Total" Pieces="_created.Garments.Count" />
        <p class="balance">Saldo pendiente: <strong>@Display.Money(_created.BalanceDue)</strong></p>
        <button type="button" class="primary" @onclick="StartOver">Nuevo ticket</button>
    </div>
}
else
{
    <ol class="steps">
        <li class="@StepClass(Step.Guest)">1. Cliente</li>
        <li class="@StepClass(Step.Garments)">2. Prendas</li>
        <li class="@StepClass(Step.Confirm)">3. Confirmar</li>
    </ol>

    @if (_step == Step.Guest)
    {
        <GuestPicker OnSelected="SelectGuest" />
    }
    else if (_step == Step.Garments)
    {
        <p class="guest-line">Cliente: <strong>@_guest!.FullName</strong> · @PhoneNumber.Format(_guest.Phone)
            <button type="button" class="link" @onclick="() => _step = Step.Guest">Cambiar</button></p>

        @if (_catalog is null)
        {
            <p>Cargando…</p>
        }
        else if (_catalog.Count == 0)
        {
            <p class="notice">Esta sucursal no tiene precios asignados. Avísale a Mercadotecnia.</p>
        }
        else
        {
            <div class="columns">
                <section>
                    @if (_current is null)
                    {
                        <p class="hint">Elige la prenda que recibes.</p>
                        <ProductPicker Catalog="_catalog" OnSelected="entry => _current = entry" />
                    }
                    else
                    {
                        <GarmentCapture Entry="_current" OnAdd="AddGarment" OnCancel="() => _current = null" />
                    }
                </section>

                <section class="ticket">
                    <h2>Ticket</h2>
                    @if (_lines.Count == 0)
                    {
                        <p class="hint">Todavía no hay prendas.</p>
                    }
                    else
                    {
                        <LineList Lines="_lines" OnRemove="RemoveLine" />
                        <Totals Total="LinesTotal" Pieces="Pieces" />
                    }
                    <button type="button" class="primary" disabled="@(_lines.Count == 0 || _current is not null)" @onclick="() => _step = Step.Confirm">Continuar</button>
                </section>
            </div>
        }
    }
    else
    {
        <GuestCard Guest="_guest!" />
        <h2>Prendas</h2>
        <LineList Lines="_lines" />
        <Totals Total="LinesTotal" Pieces="Pieces" />

        @if (_error is { } error)
        {
            <p class="error" role="alert">@ErrorMessage(error)</p>
        }
        <div class="choices">
            <button type="button" class="secondary" @onclick="() => _step = Step.Garments" disabled="@_saving">Regresar</button>
            <button type="button" class="primary" @onclick="CreateAsync" disabled="@_saving">@(_saving ? "Guardando…" : "Crear ticket")</button>
        </div>
    }
}

@code {
    private enum Step { Guest, Garments, Confirm }

    private Step _step = Step.Guest;
    private Guest? _guest;
    private List<CatalogEntry>? _catalog;
    private readonly List<TicketLine> _lines = [];

    /// <summary>The garment being captured (GarmentCapture asks its questions).</summary>
    private CatalogEntry? _current;

    private TicketError? _error;
    private bool _saving;
    private Ticket? _created;

    private decimal LinesTotal => _lines.Sum(l => l.Total);
    private int Pieces => _lines.Sum(l => l.Quantity);

    private async Task SelectGuest(Guest guest)
    {
        _guest = guest;
        _step = Step.Garments;
        if (_catalog is null && Session.CurrentUser is { } user)
            _catalog = await PriceListService.GetBranchCatalogAsync(user.BranchId);
    }

    private void AddGarment(TicketLine line)
    {
        _lines.Add(line);
        _current = null;
    }

    private void RemoveLine(TicketLine line) => _lines.Remove(line);

    private async Task CreateAsync()
    {
        _saving = true;
        _error = null;
        var garments = _lines
            .SelectMany(l => Enumerable.Repeat(new NewGarment(l.Entry.Product.Id, l.Modifiers.Select(m => m.Id).ToList()), l.Quantity))
            .ToList();

        var result = await TicketService.CreateAsync(new NewTicket(Session.CurrentUser!.Id, _guest!.Id, garments));
        if (result.Succeeded)
        {
            _created = await TicketService.GetAsync(result.Ticket!.Id);
        }
        else
        {
            _error = result.Error;
            // The catalog may have changed (a product or extra was turned off): show the current one.
            if (_error is TicketError.ProductNotAvailable or TicketError.ModifierNotAllowed)
                _catalog = await PriceListService.GetBranchCatalogAsync(Session.CurrentUser!.BranchId);
        }
        _saving = false;
    }

    private void StartOver()
    {
        _created = null;
        _guest = null;
        _lines.Clear();
        _current = null;
        _error = null;
        _step = Step.Guest;
    }

    private string StepClass(Step step) => step == _step ? "current" : step < _step ? "done" : "";

    private static string ErrorMessage(TicketError error) => error switch
    {
        TicketError.NotAllowed => "Tu usuario no puede capturar tickets.",
        TicketError.GuestNotFound => "Este cliente ya no está activo. Regresa y elige otro cliente.",
        TicketError.NoGarments => "Agrega al menos una prenda.",
        TicketError.ProductNotAvailable => "Una de las prendas ya no está disponible en esta sucursal. Regresa, quítala y vuelve a intentarlo.",
        TicketError.ModifierNotAllowed => "Uno de los servicios adicionales ya no está disponible. Regresa, quita esa prenda y vuelve a capturarla.",
        TicketError.MoreThanOneOptionPerGroup => "Una prenda tiene dos opciones del mismo grupo. Regresa, quítala y vuelve a capturarla.",
        _ => "No se pudo crear el ticket.",
    };
}
